{% extends '@PrestaShop/Admin/layout.html.twig' %}
{% trans_default_domain 'Modules.Carsmanagement.Admin' %}

{% block content %}
  <div class="card">
    <h3 class="card-header d-flex justify-content-between align-items-center">
      <span>
        <i class="material-icons">directions_car</i>
        {{ 'Cars'|trans }} ({{ cars|length }})
      </span>
      {{ include('@Modules/carsmanagement/views/templates/admin/_demo_data_button.html.twig') }}
    </h3>
    <div class="card-body">
      {% if cars is empty %}
        <p class="mb-0">{{ 'There are no cars yet. Add one or load the demo cars.'|trans }}</p>
      {% else %}
        <table class="table">
          <thead>
            <tr>
              <th>{{ 'ID'|trans }}</th>
              <th>{{ 'Registration number'|trans }}</th>
              <th>{{ 'VIN'|trans }}</th>
              <th>{{ 'Brand'|trans }}</th>
              <th>{{ 'Model'|trans }}</th>
              <th class="text-right">{{ 'Purchase price'|trans }}</th>
              <th class="text-right">{{ 'Sale price'|trans }}</th>
              <th>{{ 'Status'|trans }}</th>
              <th class="text-right">{{ 'Actions'|trans }}</th>
            </tr>
          </thead>
          <tbody>
            {% for car in cars %}
              <tr>
                <td>{{ car.id }}</td>
                <td>
                  {% if car.hasPlates %}{{ car.registrationNumber }}{% else %}<span class="text-muted">{{ 'No plates'|trans }}</span>{% endif %}
                </td>
                <td>{{ car.vin }}</td>
                <td>{{ car.brand }}</td>
                <td>{{ car.model }}</td>
                <td class="text-right">{{ car.purchasePrice|number_format(2, ',', ' ') }} €</td>
                <td class="text-right">
                  {% if car.sold %}{{ car.salePrice|number_format(2, ',', ' ') }} €{% else %}—{% endif %}
                </td>
                <td>
                  {% if car.sold %}
                    <span class="badge badge-success">{{ 'Sold'|trans }}</span>
                  {% else %}
                    <span class="badge badge-info">{{ 'In stock'|trans }}</span>
                  {% endif %}
                </td>
                <td class="text-right text-nowrap">
                  <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin_carsmanagement_cars_edit', {carId: car.id}) }}">
                    <i class="material-icons">edit</i> {{ 'Edit'|trans }}
                  </a>
                  <form class="d-inline" method="post"
                        action="{{ path('admin_carsmanagement_cars_delete', {carId: car.id}) }}"
                        onsubmit="return confirm('{{ 'Delete this car and all its expenses?'|trans|e('js') }}');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">
                      <i class="material-icons">delete</i> {{ 'Delete'|trans }}
                    </button>
                  </form>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% endif %}
    </div>
  </div>
{% endblock %}
